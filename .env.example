# Copy to .env and fill in. Never commit .env.

# Database (docker compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# For running the API outside Docker:
# DATABASE_URL=postgres://ledger:change-me@localhost:5432/ledger

# Secrets: generate each with `openssl rand -hex 32`
JWT_SECRET=
STATEMENT_LINK_SECRET=
STATEMENT_LINK_TTL_DAYS=30

# Where retailers open statement links (your public web address)
PUBLIC_WEB_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# WhatsApp: "console" logs messages instead of sending them.
WHATSAPP_MODE=console
# For WHATSAPP_MODE=cloud (Meta WhatsApp Cloud API):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=payment_reminder
WHATSAPP_RECEIPT_TEMPLATE=payment_receipt
# Webhook (retailer replies -> payment promises)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

LOG_LEVEL=info
