# Created by ./setup.sh. Never commit .env.

# Your domain, e.g. ledger.example.in. Its DNS A record must point at this server.
DOMAIN=ledger.example.in

# Images built by GitHub Actions (.github/workflows/release.yml). Replace your-github-user.
API_IMAGE=ghcr.io/your-github-user/credit-ledger-api:latest
WEB_IMAGE=ghcr.io/your-github-user/credit-ledger-web:latest

# Secrets (setup.sh fills these with random values).
POSTGRES_PASSWORD=
JWT_SECRET=
STATEMENT_LINK_SECRET=
STATEMENT_LINK_TTL_DAYS=30

# WhatsApp: "console" logs messages instead of sending them. Use "cloud" for Meta's WhatsApp Cloud API.
WHATSAPP_MODE=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=payment_reminder
WHATSAPP_RECEIPT_TEMPLATE=payment_receipt
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

LOG_LEVEL=info
